# Add environment variables here. Copy to .env and fill in values:
#   cp .env.example .env

# ── Google Sheets (type: gsheet) ────────────────────────────────────
# GOOGLE_AUTH_PRIVATE_KEY_ID=
# GOOGLE_AUTH_PRIVATE_KEY=
# GOOGLE_AUTH_EMAIL=
# GOOGLE_AUTH_CLIENT_ID=

# ── Snowflake (type: snowflake) ─────────────────────────────────────
# SNOWFLAKE_ACCOUNT=myorg-myaccount
# SNOWFLAKE_USER=
#
# One of the two auth modes (key-pair wins if both are set):
#   Password auth:
# SNOWFLAKE_PASSWORD=
#
#   Key-pair auth (literal \n in the PEM are converted to real newlines):
# SNOWFLAKE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
#
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=ANALYTICS
# SNOWFLAKE_SCHEMA=PUBLIC
# SNOWFLAKE_ROLE=ANALYST
